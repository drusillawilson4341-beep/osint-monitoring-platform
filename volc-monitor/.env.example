# 复制为 .env 并填写实际值 (systemd EnvironmentFile 也读取 .env, 值不要加引号)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# 启用数据源: volcengine / douyin / feishu
SOURCES=volcengine,douyin,feishu,assets

MAX_SEND=10
PREVIEW_LEN=600
CURRENT_MONTH_ONLY=1
RETENTION_DAYS=30

# 每两周询问是否迭代
ITERATION_ENABLED=1
ITERATION_INTERVAL_DAYS=14

# volcengine
VOLC_TYPES=188,189
VOLC_LIMIT=20

# douyin (1=小游戏 2=小程序 4=需求反馈)
DOUYIN_BIZ=1,2,4
DOUYIN_LIMIT=20

# feishu
FEISHU_LIMIT=20

# 域名资产监控(证书透明日志 crt.sh)
ASSETS_DOMAINS=volcengine.com,douyin.com,feishu.cn,arc.io
ASSETS_LIMIT=30
