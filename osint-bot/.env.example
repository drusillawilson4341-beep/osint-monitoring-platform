# osint_bot 配置: Telegram <-> Pi 对话桥接
# (值不要加引号; systemd EnvironmentFile 也读取此文件)

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HTML: 用 <tg-spoiler> 折叠展示思考过程; 所有动态内容均已转义
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_API=https://api.telegram.org

# ---- Pi (用 BOT_ 前缀, 避免与 harness 的 PI_* 环境变量冲突) ----
BOT_MODEL=deepseek-v4-pro
BOT_WORKDIR=/root/test
BOT_SESSION_ID=osint_bot
BOT_APPROVE=1
# 空=模型默认; 可选 off/minimal/low/medium/high/max
BOT_THINKING=
# 附加系统提示词(让回答更精简); 空=不附加
BOT_APPEND_PROMPT=你是运行在 Telegram 聊天机器人中的助手。回复务必精简高效: 直接给出结论, 少铺垫, 不重复; 用短句和要点列表; 代码只给必要片段; 默认不展开背景与原理, 除非用户明确要求。
BOT_PI_BIN=

# ---- 行为 ----
STREAM_EDIT_INTERVAL=1.2
STREAM_TAIL=3800
THINKING_TAIL=1500
THINKING_FINAL_MAX=3000
MSG_LIMIT=4096
TYPING_INTERVAL=4.0
PROMPT_TIMEOUT=1800
POLL_TIMEOUT=25
