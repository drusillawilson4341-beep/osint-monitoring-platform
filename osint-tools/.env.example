# ============================================================
# OSINT 工具 API key 统一配置（基本格式模板）
# ------------------------------------------------------------
# 使用: 复制本文件为 .env 后，按需填写实际值
# 规则: 值不要加引号；# 开头为注释；由 servers/osint_server.py 自动加载
# ============================================================

# ---------- 已接入工具（已生效） ----------
# shodan_host
SHODAN_API_KEY=

# virustotal_ip / virustotal_domain / virustotal_hash / virustotal_url
VIRUSTOTAL_API_KEY=

# urlscan_scan / urlscan_result
URLSCAN_API_KEY=

# ---------- 待接入工具（填好后告诉我接入） ----------
# hunter.io 邮箱枚举
HUNTER_API_KEY=

# github.com -> Settings -> Developer settings -> Tokens（可选，提高 API 限额）
GITHUB_TOKEN=

# ---------- 可选预留（按需填写，接入时使用） ----------
# censys.io 资产测绘（需与 CENSYS_API_SECRET 配套）
CENSYS_API_ID=
CENSYS_API_SECRET=

# securitytrails.com DNS/子域历史
SECURITYTRAILS_API_KEY=

# binaryedge.io 资产测绘
BINARYEDGE_API_KEY=

# greynoise.io 扫描噪声情报
GREYNOISE_API_KEY=

# abuseipdb.com IP 滥用信誉
ABUSEIPDB_API_KEY=

# ipinfo.io IP 归属/ASN
IPINFO_API_KEY=
